# Optional public Self Service configuration. Leave BOTH empty for the standalone demo.
# If either value is supplied, both must be valid. No backend requests are added.

# Full API root: origin + optional deployment/API prefix + /v1/self.
# Example: https://localhost:8443/fineract-provider/api/v1/self
# HTTPS is mandatory in Docker. Only Vite development permits loopback HTTP.
SELF_SERVICE_BASE_URL=

# Public tenant identifier for the future Fineract-Platform-TenantId header.
# Example: default
# 1-100 letters/digits/underscores/hyphens; starts with a letter or digit.
SELF_SERVICE_TENANT_ID=

# Mifos Self-Service Authentication API base URL.
# Used by the Login component for the authentication endpoint.
# Falls back to https://apis.mifos.community/1.0/online/v1/self if not set.
# Example: https://api.example.com/v1/self
VITE_API_BASE_URL=

# No API keys, passwords, or tokens: these values are browser-visible.
# npm run dev and Docker Compose both use these same names.